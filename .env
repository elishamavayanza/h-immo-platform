# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Une valeur VIDE rend les identifiants de session prévisibles et le
# jeton CSRF absent. Elle ne doit jamais être laissée vide.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> jeton d'API (JWT) ###
# Clé de signature HS256 : 32 octets aléatoires en hexadécimal.
# La valeur réelle vit dans .env.local, jamais dans un fichier versionné.
# Régénérer : php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
JWT_SECRET=
# Durée de vie du jeton, en secondes (1 h).
JWT_TTL=3600
###< jeton d'API ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.symfony.com/doc/current/doctrine.html#configuring-a-database-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# MariaDB est le SGBD du projet. Le schéma `mysql://` associé à un
# `serverVersion` MariaDB indique à Doctrine DBAL d'utiliser la plateforme
# MariaDB : c'est cette plateforme qui produit le SQL des migrations
# (AUTO_INCREMENT, BINARY(16), LONGTEXT, utf8mb4) et qui évite que Doctrine
# émette un `SERIAL` ou un `JSONB` qu'un PostgreSQL seule comprendrait.
#
# `serverVersion` doit correspondre au serveur réellement utilisé : il
# détermine le SQL généré, et non la version négociée lors de la
# connexion. Une valeur fausse produit des migrations qui s'exécutent sur
# une base et échouent sur l'autre.
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=mariadb-11.8.6&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
# Adresse d'expéditeur des emails transactionnels (invitations, reset).
MAILER_FROM_ADDRESS="no-reply@himmo.cd"
###< symfony/mailer ###

# URL du front React, cible des liens présents dans les emails.
APP_FRONTEND_URL="http://localhost:5173"

###> h-immo/compte administrateur par défaut ###
# Compte SUPER_ADMIN initial, créé par :
#   php bin/console app:super-admin:create
#
# Le mot de passe n'est volontairement PAS défini ici (fichier versionné) :
#   - option --password=<mot de passe>
#   - ou variable DEFAULT_ADMIN_PASSWORD dans .env.local (non versionné)
#   - sinon il est généré aléatoirement et affiché une seule fois.
DEFAULT_ADMIN_EMAIL=admin@himmo.cd
DEFAULT_ADMIN_FULL_NAME="Administrateur H-Immo"
###< h-immo/compte administrateur par défaut ###
