.vp/
.vpp_backup/
.vpbackup/

# Visual Paradigm generated reports / exports
/vp-reports/
/vp-export/


# ============================================================
# Visual Paradigm - KEEP ONLY THE MAIN MODEL
# ============================================================

# IMPORTANT:
# The principal .vpp model containing the official uml
# must remain tracked manually.
#
# Example:
# /docs/uml/H-Immo.vpp
#
# Do NOT add *.vpp globally because the main model must
# be committed to Git.


# ============================================================
# Documentation generated files
# ============================================================

/docs/generated/
/docs/export/
/docs/build/


# ============================================================
# Frontend generated assets
# ============================================================

/assets/app/node_modules/
/assets/app/dist/
/assets/app/build/


