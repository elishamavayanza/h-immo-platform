flowchart TB

%% ============================================================
%% STYLES
%% ============================================================
    classDef platform fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#111;
    classDef access fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#111;
    classDef property fill:#fff8e1,stroke:#f9a825,stroke-width:2px,color:#111;
    classDef rental fill:#fce4ec,stroke:#ad1457,stroke-width:2px,color:#111;
    classDef system fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#111;
    classDef cycle fill:#eeeeee,stroke:#424242,stroke-width:1px,color:#111;
    classDef technical fill:#e0f7fa,stroke:#00838f,stroke-width:2px,color:#111;
    classDef security fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#111;
    classDef capacity fill:#fff3e0,stroke:#ef6c00,stroke-width:2px,color:#111;

%% ============================================================
%% 1. ARCHITECTURE TECHNIQUE
%% ============================================================
    subgraph ARCHITECTURE ["ARCHITECTURE TECHNIQUE"]
        direction LR
        FRONTEND["React + TypeScript<br/>Web Application"]
        API["Symfony 7.4<br/>REST API"]
        SECURITY["Security<br/><br/>JWT<br/>Authorization<br/>Tenant Isolation"]
        APPLICATION["Application Layer<br/><br/>Use Cases<br/>Validation<br/>Business Rules"]
        CAPACITY_SERVICE["OrganizationCapacityService<br/><br/>Usage counters<br/>Limits<br/>Concurrency lock"]
        DOMAIN["Domain Layer<br/><br/>Entities<br/>Enums"]
        ORM["Doctrine ORM"]

        FRONTEND -->|"HTTPS / JSON"| API
        API --> SECURITY
        SECURITY --> APPLICATION
        APPLICATION --> DOMAIN
        APPLICATION --> CAPACITY_SERVICE
        CAPACITY_SERVICE --> DOMAIN
        DOMAIN --> ORM
    end

%% ============================================================
%% 2. REGLES DE SECURITE
%% ============================================================
    subgraph SECURITY_RULES ["REGLES DE SECURITE"]
        direction LR
        S1["Isolation<br/>Organization"]
        S2["Authorization<br/>Backend"]
        S3["ADMIN_VILLE<br/>City autorisées"]
        S4["SUPER_ADMIN<br/>Plateforme séparée"]
        S5["Contrôle<br/>à chaque opération"]
        S6["Capacités configurées<br/>par SUPER_ADMIN"]
        S7["Compteurs bornés<br/>à l'organisation"]
        S8["Plafonds appliqués<br/>côté API"]
    end

    SECURITY --> S1 & S2 & S3 & S4 & S5 & S6 & S7 & S8

%% ============================================================
%% 3. DOMAINES METIER (CŒUR DU SYSTEME)
%% ============================================================
    subgraph DOMAINS ["DOMAINES METIER"]
        direction LR

    %% --- PLATEFORME & ACCES ---
        subgraph PLATFORM ["1. PLATEFORME & ACCES"]
            direction TB
            SUPER_ADMIN["SUPER_ADMIN<br/>Plateforme"]
            ORGANIZATION["Organization<br/>Entreprise"]
            ORG_CAPACITY["Capacités Organization<br/><br/>maxCities<br/>maxParcels<br/>maxBuildings<br/>maxUnits<br/>maxMembers"]
            SHOWCASE_ACCESS["showcaseEnabled<br/>Autorisation de la Vitrine"]
            ORG_SETUP["OrganizationSetupPage<br/><br/>Identité<br/>Capacités<br/>Compte PATRON<br/>Logo"]
            PATRON["PATRON<br/>Responsable"]
            USER["User<br/>Utilisateur"]
            ORG_USER["OrganizationUser<br/>Appartenance + rôle"]
            USER_CITY["UserCity<br/>Villes autorisées"]

            SUPER_ADMIN -->|"administre"| ORGANIZATION
            SUPER_ADMIN -->|"configure"| ORG_SETUP
            ORG_SETUP -->|"crée / modifie"| ORGANIZATION
            ORGANIZATION -->|"porte"| ORG_CAPACITY
            ORGANIZATION -->|"porte"| SHOWCASE_ACCESS
            ORGANIZATION -->|"désigne"| PATRON
            PATRON -->|"gère"| ORG_USER
            USER -->|"appartient"| ORG_USER
            ORGANIZATION -->|"possède"| ORG_USER
            USER -->|"accès géographique"| USER_CITY
        end

    %% --- CONFIGURATION DES OFFRES ET CAPACITES ---
        subgraph CAPACITY_CONFIGURATION["4. CONFIGURATION DES CAPACITES"]
            direction TB
            CAPACITY_SERVICE_NODE["OrganizationCapacityService<br/><br/>Comptage de l'usage<br/>Vérification des plafonds"]
            CAPACITY_LOCK["Verrou MariaDB par organisation<br/>et type de ressource"]
            READ_CAPACITY["Lecture des capacités<br/>PATRON / ADMIN_IMMOBILIER<br/>dans leur organisation"]
            NO_LIMIT["Sans limite<br/>null"]

            ORG_CAPACITY -->|"définit les maximums"| CAPACITY_SERVICE_NODE
            CAPACITY_SERVICE_NODE -->|"compte en base"| CAPACITY_LOCK
            ORG_CAPACITY -->|"null = illimité"| NO_LIMIT
            READ_CAPACITY -->|"lecture seule"| ORG_CAPACITY
        end

    %% --- PATRIMOINE IMMOBILIER ---
        subgraph PROPERTY ["2. PATRIMOINE IMMOBILIER"]
            direction TB
            CITY["City<br/>Ville"]
            PARCEL["Parcel<br/>Parcelle"]
            BUILDING["Building<br/>Immeuble"]
            UNIT["Unit<br/>Unité"]

            ORGANIZATION -->|"gère"| CITY
            USER_CITY -->|"autorise"| CITY
            CITY -->|"contient"| PARCEL
            PARCEL -->|"contient"| BUILDING
            BUILDING -->|"contient"| UNIT
        end

    %% --- GESTION LOCATIVE ---
        subgraph RENTAL ["3. GESTION LOCATIVE"]
            direction TB
            TENANT["Tenant<br/>Locataire"]
            LEASE["Lease<br/>Contrat"]
            RENT["Rent<br/>Loyer"]
            PAYMENT["Payment<br/>Paiement"]

            ORGANIZATION -->|"gère"| TENANT
            UNIT -->|"est louée via"| LEASE
            TENANT -->|"signe"| LEASE
            LEASE -->|"génère"| RENT
            RENT -->|"est réglé par"| PAYMENT
            USER -->|"enregistre"| PAYMENT
        end
    end

    subgraph STAFF ["5. GESTION DES DEPENSES ET DU PERSONNEL"]
        direction TB
        WORKER["Worker<br/>Travailleur"]
        ASSIGNMENT["WorkerAssignment<br/>Affectation"]
        EXPENSE["Expense<br/>Dépense"]
        WORKER_ROLE["WorkerRole<br/>Fonction"]
        EXPENSE_CATEGORY["ExpenseCategory<br/>Nature"]

        ORGANIZATION -->|"emploie"| WORKER
        WORKER -->|"est affecté par"| ASSIGNMENT
        CITY -->|"lieu d'exercice"| ASSIGNMENT
        PARCEL -.->|"cible"| ASSIGNMENT
        BUILDING -.->|"cible"| ASSIGNMENT
        UNIT -.->|"cible"| ASSIGNMENT
        WORKER_ROLE -->|"qualifie"| ASSIGNMENT

        ORGANIZATION -->|"engage"| EXPENSE
        CITY -->|"porte"| EXPENSE
        PARCEL -.->|"cible"| EXPENSE
        BUILDING -.->|"cible"| EXPENSE
        UNIT -.->|"cible"| EXPENSE
        WORKER -.->|"bénéficiaire"| EXPENSE
        USER -->|"enregistre"| EXPENSE
        EXPENSE_CATEGORY -->|"catégorise"| EXPENSE
    end

%% ============================================================
%% 6. SYSTEME & TRAÇABILITE
%% ============================================================
    subgraph SYSTEM ["6. SYSTEME & TRAÇABILITE"]
        direction LR
        AUDIT["AuditLog<br/>Traçabilité"]
        FILE_STORAGE["File Storage<br/>Photos & Logos"]

        USER -->|"actions"| AUDIT
        ORGANIZATION -->|"contexte"| AUDIT
        USER -->|"photo"| FILE_STORAGE
        ORGANIZATION -->|"logo"| FILE_STORAGE
    end

%% ============================================================
%% 7. INFRASTRUCTURE & DONNEES
%% ============================================================
    subgraph INFRASTRUCTURE ["INFRASTRUCTURE & DONNEES"]
        direction LR
        DATABASE[("Relational Database<br/>Soft-IMMO")]
        STORAGE[("File Storage<br/>Uploads")]
    end

    ORM --> DATABASE
    APPLICATION --> STORAGE

%% ============================================================
%% 8. CYCLE D'ACTIVITE METIER
%% ============================================================
    subgraph BUSINESS_CYCLE ["CYCLE D'ACTIVITE METIER"]
        direction LR
        C1["1<br/>Organisation"] --> C2["2<br/>Capacités & options"] --> C3["3<br/>Utilisateurs"] --> C4["4<br/>Rôles & accès"] --> C5["5<br/>Villes"] --> C6["6<br/>Parcelles"] --> C7["7<br/>Bâtiments"] --> C8["8<br/>Unités"] --> C9["9<br/>Locataires"] --> C10["10<br/>Contrats"] --> C11["11<br/>Loyers"] --> C12["12<br/>Paiements"] --> C13["13<br/>Audit"]
    end

%% ============================================================
%% LIENS ARCHITECTURAUX (TRANSVERSAUX)
%% ============================================================
    DATABASE -.->|"persiste"| PLATFORM
    DATABASE -.->|"persiste"| PROPERTY
    DATABASE -.->|"persiste"| RENTAL
    DATABASE -.->|"persiste"| SYSTEM
    DATABASE -.->|"persiste"| CAPACITY_CONFIGURATION
    CAPACITY_SERVICE_NODE -->|"autorise ou refuse la création"| CITY
    CAPACITY_SERVICE_NODE -->|"autorise ou refuse la création"| PARCEL
    CAPACITY_SERVICE_NODE -->|"autorise ou refuse la création"| BUILDING
    CAPACITY_SERVICE_NODE -->|"autorise ou refuse la création"| UNIT
    CAPACITY_SERVICE_NODE -->|"autorise ou refuse l'ajout"| ORG_USER
    SHOWCASE_ACCESS -.->|"conditionne le menu selon le rôle"| PATRON
    SHOWCASE_ACCESS -.->|"conditionne le menu selon le rôle"| ORG_USER
    DOMAIN -.->|"supporte"| BUSINESS_CYCLE
    SECURITY -.->|"protège"| BUSINESS_CYCLE

%% ============================================================
%% ASSIGNATION DES CLASSES
%% ============================================================
    class SUPER_ADMIN,ORGANIZATION,PATRON platform;
    class ORG_CAPACITY,SHOWCASE_ACCESS,ORG_SETUP,READ_CAPACITY,NO_LIMIT,CAPACITY_SERVICE_NODE,CAPACITY_LOCK capacity;
    class USER,ORG_USER,USER_CITY access;
    class CITY,PARCEL,BUILDING,UNIT property;
    class TENANT,LEASE,RENT,PAYMENT rental;
    class WORKER,ASSIGNMENT,EXPENSE,WORKER_ROLE,EXPENSE_CATEGORY expense;
    class AUDIT,FILE_STORAGE system;
    class C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12,C13 cycle;
    class FRONTEND,API,SECURITY,APPLICATION,CAPACITY_SERVICE,DOMAIN,ORM,DATABASE,STORAGE technical;
    class S1,S2,S3,S4,S5,S6,S7,S8 security;
