%% ============================================================
%% 2. IDENTITE ET ACCES
%% ============================================================

subgraph ACCESS["IDENTITY & ACCESS"]

USER["User<br/>Compte utilisateur"]

ORG_USER["OrganizationUser<br/>Appartenance à l'entreprise<br/>+ rôle"]

USER_CITY["UserCity<br/>Accès aux villes autorisées"]

ROLES["Organization Roles<br/><br/>PATRON<br/>ADMIN_IMMOBILIER<br/>ADMIN_VILLE"]

end

