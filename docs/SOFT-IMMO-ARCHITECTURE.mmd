%% ============================================================
%% 1. ADMINISTRATION DE LA PLATEFORME
%% ============================================================

subgraph PLATFORM["PLATEFORME SOFT-IMMO"]

SUPER_ADMIN["SUPER_ADMIN<br/>Administrateur de la plateforme"]

